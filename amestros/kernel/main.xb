#include "syscall.xh"
#include "firmware.xh"
#include "shell.xh"
#include "device.xh"

main(a,b)
{
	init_syscall_table();
	irq_init();
	d_hwscan();
	d_init_tty();
	d_init_monitor_txtmode();
	i_print_sys_info();
	d_init_keyboard();
	d_init_diskreader();
//	s_load_bootdisk();

	sh_start(); // [ ] This should actually be "read some settings file to see what to boot", and "sh" should just be a program like any other.

	return 0;
}
