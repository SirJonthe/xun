#include "shell.xh"
#include "def.xh"
#include "stdio.xh"
#include "string.xh"
#include "firmware.xh"

auto sh_run = FALSE;

auto wd[256];
auto wd_n = 0;

_wd_reset( void )
{
	wd[0] = '/';
	wd[1] = 0;
	wd_n = 1;
}

_wd_nav_back( void )
{
	while (wd_n > 1) {
		wd_n--;
		if (wd[wd_n] == '/') {
			wd[wd_n] = 0;
			return;
		}
	}
}

_wd_nav_fw(dir, n)
{
	if (n == 0 || dir == NULL) {
		return FALSE;
	}
	if (wd_n + n > sizeof(wd)) {
		return FALSE;
	}
	auto i = 0;
	while (i < n) {
		wd[wd_n] = dir[i];
		++wd_n;
		++i;
	}
	wd[wd_n] = 0;
	return TRUE;
}

_wd_nav(navstr, n)
{
	static BACK[2] = "..";

	if (n == 0 || navstr == NULL) {
		return;
	}
	if (n == 1 && navstr[0] == '/') {
		_wd_reset();
		return;
	}

	auto a = 0;
	auto b = 0;
	while (b < n) {
		if (navstr[b] == '/') {
			if ((b - a) == 2 && strcmp(navstr, BACK, 2)) {
				_wd_nav_back();
			} else {
				_wd_nav_fw(navstr + a, b - a);
			}
			a = b + 1;
		}
		++b;
	}

	if (a != b) {
		if ((b - a) == 2 && strcmp(navstr, BACK, 2)) {
			_wd_nav_back();
		} else {
			_wd_nav_fw(navstr + a, b - a);
		}
	}
}

auto usr[32];
auto usr_n;

_usr_reset( void )
{
	auto default_usr[] = "root";
	memcpy(usr, default_usr, sizeof(default_usr));
	usr_n = sizeof(default_usr);
}

auto host[32];
auto host_n;

_host_reset( void )
{
	auto default_host[] = "amestros";
	memcpy(host, default_host, sizeof(default_host));
	host_n = sizeof(default_host);
}

sh_start( void )
{
	_wd_reset();
	_usr_reset();
	_host_reset();

	sh_run = TRUE;

	while (sh_run) {
		{
			static prompt[] = "\n[%s@%s %s] $ ";
			auto params[] = { usr, host, wd };
			printf(prompt, params);
		}

		auto in[256];
		auto in_n = gets(in, sizeof(in));

		if (sh_exec_line(in, in_n) != EXIT_SUCCESS) {
			static fmt[] = "\ncommand not found: %s";
			auto prm[] = { in };
			printf(fmt, prm);
		}
	}
}

sh_end( void )
{
	sh_run = FALSE;
}

sh_exec_line(line, line_n)
{
	// [ ] do something with "in" (generally, split by white space, fopen("/bin/" + first_word), load all other words as parameters, call buf() and return its value.

	static cmd_exit[]     = "exit";
	static cmd_shutdown[] = "shutdown";
	static cmd_reboot[]   = "reboot";
	static cmd_pwd[]      = "pwd";
	static cmd_clear[]    = "clear";
	{
		auto fmt[] = "\n%u (%u), %u (%u), %u (%u), %u (%u), %u (%u)\n";
		auto prm[] = { cmd_exit, sizeof(cmd_exit), cmd_shutdown, sizeof(cmd_shutdown), cmd_reboot, sizeof(cmd_reboot), cmd_pwd, sizeof(cmd_pwd), cmd_clear, sizeof(cmd_clear) };
		printf(fmt, prm);
	}

	const NUM_CMD = 5;
	auto cmd[NUM_CMD] = { cmd_exit, cmd_shutdown, cmd_reboot, cmd_pwd, cmd_clear };
	auto fn[NUM_CMD]  = { sh_end, shutdown, reboot, sh_pwd, d_monitor_txtclear };

	auto i = 0;
	while (i < NUM_CMD) {
		{
			auto fmt[] = "%s = %s...";
			auto prm[] = { line, cmd[i] };
			printf(fmt, prm);
		}
		if (strlen(cmd[i]) == line_n && strcmp(line, cmd[i], line_n)) {
			//{
			//	auto fmt[] = "true\n";
			//	printf(fmt, NULL);
			//}
			auto fn = fn[i];
			return fn();
		}
		{
			auto fmt[] = "false\n";
			printf(fmt, NULL);
		}
		++i;
	}

	return -1;
}

sh_pwd( void )
{
	printf(wd, NULL);
}
