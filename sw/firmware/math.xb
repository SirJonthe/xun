min2(a, b)
{
	if (a < b) {
		return a;
	}
	return b;
}

max2(a, b)
{
	if (a > b) {
		return a;
	}
	return b;
}

min(v, n)
{
	auto m = v[0];
	auto i = 1;
	while (i < n) {
		m = min2(m, v[i]);
		++i;
	}
	return m;
}

max(v, n)
{
	auto m = v[0];
	auto i = 1;
	while (i < n) {
		m = max2(m, v[i]);
		++i;
	}
	return m;
}