#include "str.xh"
#include "def.xh"

strcmp(a, b, n)
{
	auto i = 0;
	while (i < n) {
		if (a[i] != b[i]) {
			return FALSE;
		}
		++i;
	}
	return TRUE;
}

strlen(str)
{
	auto size = 0;
	while (str[size] != 0) {
		++size;
	}
	return size;
}

memset(dst, val, n)
{
	auto i = 0;
	while (i < n) {
		dst[i] = val;
		++i;
	}
}

memcpy(dst, src, n)
{
	auto i = 0;
	while (i < n) {
		dst[i] = src[i];
		++i;
	}
	return TRUE;
}
