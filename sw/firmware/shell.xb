#include "shell.xh"
#include "def.xh"
#include "stdio.xh"
#include "str.xh"

auto sh_run = FALSE;

auto wd[256];
auto wd_n = 0;

_wd_reset( void )
{
	wd[0] = '/';
	wd[1] = 0;
	wd_n = 1;
}

_wd_nav_back( void )
{
	while (wd_n > 1) {
		wd_n--;
		if (wd[wd_n] == '/') {
			wd[wd_n] = 0;
			return;
		}
	}
}

_wd_nav_fw(dir, n)
{
	if (n == 0 || dir == NULL) {
		return FALSE;
	}
	if (wd_n + n > sizeof(wd)) {
		return FALSE;
	}
	auto i = 0;
	while (i < n) {
		wd[wd_n] = dir[i];
		++wd_n;
		++i;
	}
	wd[wd_n] = 0;
	return TRUE;
}

_wd_nav(navstr, n)
{
	static BACK[2] = "..";

	if (n == 0 || navstr == NULL) {
		return;
	}
	if (n == 1 && navstr[0] == '/') {
		_wd_reset();
		return;
	}

	auto a = 0;
	auto b = 0;
	while (b < n) {
		if (navstr[b] == '/') {
			if ((b - a) == 2 && strcmp(navstr, BACK, 2)) {
				_wd_nav_back();
			} else {
				_wd_nav_fw(navstr + a, b - a);
			}
			a = b + 1;
		}
		++b;
	}

	if (a != b) {
		if ((b - a) == 2 && strcmp(navstr, BACK, 2)) {
			_wd_nav_back();
		} else {
			_wd_nav_fw(navstr + a, b - a);
		}
	}
}

auto usr[32];
auto usr_n;

_usr_reset( void )
{
	auto default_usr[] = "root";
	memcpy(usr, default_usr, sizeof(default_usr));
	usr_n = sizeof(default_usr);
}

auto mach[32];
auto mach_n;

_mach_reset( void )
{
	auto default_mach[] = "xun";
	memcpy(mach, default_mach, sizeof(default_mach));
	mach_n = sizeof(default_mach);
}

sh_start( void )
{
	_wd_reset();
	_usr_reset();
	_mach_reset();

	sh_run = TRUE;

	while (sh_run) {
		{
			static prompt[] = "[%s@%s %s] $ ";
			auto params[] = { usr, mach, wd };
			printf(prompt, params);
		}

		auto in[256];
		auto in_n = gets(in, sizeof(in));
		// [ ] do something with "in"
	}
}

sh_end( void )
{
	sh_run = FALSE;
}
