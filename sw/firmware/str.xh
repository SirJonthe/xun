/// @brief Compares the contents of two strings of equal size.
/// @param a A string.
/// @param b Another string.
/// @param n The number of characters to compare.
/// @returns 1 if the strings exactly match. 0 otherwise.
strcmp(a, b, n);

/// @brief Gets the dynamic size of the string as defined by a trailing 0 terminator character.
/// @param str The string.
/// @returns The size of the string.
strlen(str);

/// @brief Sets all elements in destination to the given value.
/// @param dst The destination pointer.
/// @param val The value to set the elements at the destination pointer.
/// @param n The number of elements at the destination pointer to set.
memset(dst, val, n);

/// @brief Copies memory from source to destination.
/// @param dst The destination memory.
/// @param src The source memory.
/// @param n The number of elements to copy into destination from source.
memcpy(dst, src, n);
